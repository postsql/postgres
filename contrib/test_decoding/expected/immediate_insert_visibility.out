-- Logical decoding tests for immediate_global_insert_visibility
SET synchronous_commit = on;
SELECT 'init' FROM pg_create_logical_replication_slot('regression_slot', 'test_decoding');
 ?column? 
----------
 init
(1 row)

CREATE TABLE imm_decode_tab (
    id int PRIMARY KEY,
    val text,
    large_val text
);
CREATE TABLE norm_decode_tab (
    id int PRIMARY KEY,
    val text
);
-- 1. Aborted transaction with immediate-visibility insert (plus TOAST) and normal insert:
--    Only the immediate-visibility insert should be decoded; the normal insert must be discarded.
BEGIN;
SET LOCAL immediate_global_insert_visibility = 'imm_decode_tab';
INSERT INTO imm_decode_tab VALUES (1, 'survived abort', repeat('x', 5000));
INSERT INTO norm_decode_tab VALUES (1, 'discarded on abort');
ROLLBACK;
SELECT data FROM pg_logical_slot_get_changes('regression_slot', NULL, NULL, 'include-xids', '0', 'skip-empty-xacts', '1');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   data                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 BEGIN
 table public.imm_decode_tab: INSERT: id[integer]:1 val[text]:'survived abort' large_val[text]:''
 COMMIT
(3 rows)

-- 2. Unique constraint violation on immediate-visibility table:
--    Failed duplicate-key insert must NOT be frozen and must NOT be decoded.
BEGIN;
SET LOCAL immediate_global_insert_visibility = 'imm_decode_tab';
INSERT INTO imm_decode_tab VALUES (1, 'duplicate key', NULL);
ERROR:  duplicate key value violates unique constraint "imm_decode_tab_pkey"
DETAIL:  Key (id)=(1) already exists.
ROLLBACK;
SELECT data FROM pg_logical_slot_get_changes('regression_slot', NULL, NULL, 'include-xids', '0', 'skip-empty-xacts', '1');
 data 
------
(0 rows)

-- 3. Multi-row INSERT and COPY (heap_multi_insert) in an aborted transaction
BEGIN;
SET LOCAL immediate_global_insert_visibility = 'imm_decode_tab';
INSERT INTO imm_decode_tab VALUES (2, 'multi 2', NULL), (3, 'multi 3', NULL);
COPY imm_decode_tab (id, val, large_val) FROM STDIN;
ROLLBACK;
SELECT data FROM pg_logical_slot_get_changes('regression_slot', NULL, NULL, 'include-xids', '0', 'skip-empty-xacts', '1');
                                            data                                             
---------------------------------------------------------------------------------------------
 BEGIN
 table public.imm_decode_tab: INSERT: id[integer]:2 val[text]:'multi 2' large_val[text]:null
 table public.imm_decode_tab: INSERT: id[integer]:3 val[text]:'multi 3' large_val[text]:null
 table public.imm_decode_tab: INSERT: id[integer]:4 val[text]:'copy 4' large_val[text]:null
 table public.imm_decode_tab: INSERT: id[integer]:5 val[text]:'copy 5' large_val[text]:null
 COMMIT
(6 rows)

-- 4. Savepoint rollback inside a committed transaction:
--    Immediate-visibility insert inside the rolled-back savepoint must still be decoded,
--    while normal insert inside the rolled-back savepoint is discarded.
BEGIN;
INSERT INTO norm_decode_tab VALUES (10, 'top committed');
SAVEPOINT sp1;
SET LOCAL immediate_global_insert_visibility = 'imm_decode_tab';
INSERT INTO imm_decode_tab VALUES (6, 'survived savepoint rollback', NULL);
INSERT INTO norm_decode_tab VALUES (11, 'discarded by savepoint rollback');
ROLLBACK TO SAVEPOINT sp1;
COMMIT;
SELECT data FROM pg_logical_slot_get_changes('regression_slot', NULL, NULL, 'include-xids', '0', 'skip-empty-xacts', '1');
                                                      data                                                       
-----------------------------------------------------------------------------------------------------------------
 BEGIN
 table public.norm_decode_tab: INSERT: id[integer]:10 val[text]:'top committed'
 table public.imm_decode_tab: INSERT: id[integer]:6 val[text]:'survived savepoint rollback' large_val[text]:null
 COMMIT
(4 rows)

-- 5. Released savepoint followed by top-level ROLLBACK
BEGIN;
SAVEPOINT sp1;
SET LOCAL immediate_global_insert_visibility = 'imm_decode_tab';
INSERT INTO imm_decode_tab VALUES (7, 'released sp then top rollback', NULL);
INSERT INTO norm_decode_tab VALUES (12, 'discarded by top rollback');
RELEASE SAVEPOINT sp1;
ROLLBACK;
SELECT data FROM pg_logical_slot_get_changes('regression_slot', NULL, NULL, 'include-xids', '0', 'skip-empty-xacts', '1');
                                                       data                                                        
-------------------------------------------------------------------------------------------------------------------
 BEGIN
 table public.imm_decode_tab: INSERT: id[integer]:7 val[text]:'released sp then top rollback' large_val[text]:null
 COMMIT
(3 rows)

DROP TABLE imm_decode_tab;
DROP TABLE norm_decode_tab;
SELECT pg_drop_replication_slot('regression_slot');
 pg_drop_replication_slot 
--------------------------
 
(1 row)

