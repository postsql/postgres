SELECT count(*) FROM pg_class WHERE relname LIKE 'rid_%_seq';
 count 
-------
     0
(1 row)

-- Verify explicit PK index plus partial rowid index on rid_explicit_pk
SELECT indexrelid::regclass, indisprimary, indisunique, pg_get_expr(indpred, indrelid) AS pred
FROM pg_index
WHERE indrelid = 'rid_explicit_pk'::regclass
ORDER BY indexrelid::regclass::text;
          indexrelid          | indisprimary | indisunique |     pred     
------------------------------+--------------+-------------+--------------
 rid_explicit_pk_id_rowid_idx | f            | t           | (id IS NULL)
 rid_explicit_pk_pkey         | t            | t           | 
(2 rows)

-- Verify psql \d output
\d rid_basic
                          Table "public.rid_basic"
 Column |  Type   | Collation | Nullable |             Default              
--------+---------+-----------+----------+----------------------------------
 id     | bigint  |           | not null | generated always as row identity
 val    | text    |           |          | 
 num    | integer |           |          | 
Indexes:
