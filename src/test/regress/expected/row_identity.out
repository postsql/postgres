EXPLAIN (COSTS OFF) SELECT id, num FROM rid_basic WHERE id IN (1, 2, 3, 4, 6, 10, 42);
                       QUERY PLAN                       
--------------------------------------------------------
 Tid Scan on rid_basic
   TID Cond: (id = ANY ('{1,2,3,4,6,10,42}'::bigint[]))
(2 rows)

SELECT id, num FROM rid_basic WHERE id IN (1, 2, 3, 4, 6, 10, 42) ORDER BY id;
 id | num 
----+-----
