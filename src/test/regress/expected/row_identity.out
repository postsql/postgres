  2 |  20
  3 |    
  4 |  40
  6 |  60
 10 | 100
(6 rows)

-- Parameterized Prepared Statement plan
PREPARE rid_lookup(bigint) AS SELECT id, num FROM rid_basic WHERE id = $1;
EXPLAIN (COSTS OFF) EXECUTE rid_lookup(1);
           QUERY PLAN           
--------------------------------
 Tid Scan on rid_basic
   TID Cond: (id = '1'::bigint)
(2 rows)

EXECUTE rid_lookup(1);
 id | num 
----+-----
  1 |  12
(1 row)

EXECUTE rid_lookup(3);
 id | num 
----+-----
  3 |    
(1 row)

EXECUTE rid_lookup(10);
 id | num 
----+-----
 10 | 100
(1 row)

EXECUTE rid_lookup(7777);
 id | num 
----+-----
(0 rows)

DEALLOCATE rid_lookup;
-- Verify SeqScan matches point lookups for all rows
SET enable_tidscan = off;
SELECT id, length(val), num FROM rid_basic ORDER BY id;
 id | length | num 
----+--------+-----
  1 |   3000 |  12
  2 |   3000 |  20
  3 |   3000 |    
  4 |      5 |  40
  5 |      7 |  50
  6 |     11 |  60
 10 |     14 | 100
(7 rows)

RESET enable_tidscan;
-- 7. JIT Tuple Deformation Verification (both elided home and inline off-home tuples)
SET jit = on;
SET jit_above_cost = 0;
SET jit_tuple_deforming = on;
SELECT id, length(val), num FROM rid_basic ORDER BY id;
 id | length | num 
----+--------+-----
  1 |   3000 |  12
  2 |   3000 |  20
  3 |   3000 |    
  4 |      5 |  40
  5 |      7 |  50
  6 |     11 |  60
 10 |     14 | 100
(7 rows)

RESET jit;
RESET jit_above_cost;
RESET jit_tuple_deforming;
-- 8. Off-Page Anchor Lifecycle & Two-Phase VACUUM Reclamation
-- Delete the off-page tuple (id = 3) and verify that its home root slot (0, 3)
-- is anchored until VACUUM cleans up the off-page tuple, and reclaimed across two VACUUMs.
CREATE PROCEDURE rid_wait_for_xmin_horizon() LANGUAGE plpgsql AS $$
BEGIN
    FOR i IN 1..100 LOOP
        PERFORM pg_stat_clear_snapshot();
        PERFORM pg_cancel_backend(pid)
        FROM pg_stat_activity
        WHERE backend_type = 'autovacuum worker';
        EXIT WHEN NOT EXISTS (
            SELECT 1 FROM pg_stat_activity
            WHERE pid <> pg_backend_pid()
              AND (backend_xmin IS NOT NULL OR backend_xid IS NOT NULL)
        );
        COMMIT;
        PERFORM pg_sleep(0.05);
    END LOOP;
END $$;
DELETE FROM rid_basic WHERE id = 3;
SELECT id, num FROM rid_basic WHERE id = 3;
 id | num 
----+-----
(0 rows)

-- First VACUUM: cleans dead tuple on target page and transitions (0, 3) anchor
CALL rid_wait_for_xmin_horizon();
VACUUM rid_basic;
SELECT id, num FROM rid_basic WHERE id = 3;
 id | num 
----+-----
(0 rows)

-- Second VACUUM: reclaims (0, 3) back to LP_UNUSED
CALL rid_wait_for_xmin_horizon();
VACUUM rid_basic;
-- Now a new INSERT can reuse slot (0, 3) -> id = 3!
INSERT INTO rid_basic (val, num) VALUES ('reclaimed_slot_3', 300)
RETURNING id, ctid, val, num;
 id | ctid  |       val        | num 
----+-------+------------------+-----
  3 | (0,3) | reclaimed_slot_3 | 300
(1 row)

-- 9. Partitioned Table & partition_bits / partition_id Support
CREATE TABLE rid_part (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    region int NOT NULL,
    payload text
) PARTITION BY LIST (region) WITH (partition_bits = 8);
CREATE TABLE rid_part_p1 PARTITION OF rid_part FOR VALUES IN (1)
    WITH (partition_bits = 8, partition_id = 1);
CREATE TABLE rid_part_p2 PARTITION OF rid_part FOR VALUES IN (2)
    WITH (partition_bits = 8, partition_id = 2);
INSERT INTO rid_part (region, payload) VALUES (1, 'p1_row1'), (2, 'p2_row1');
SELECT tableoid::regclass AS part,
       id,
       (id >> 48) AS extracted_part_id,
       (id & 65535) AS extracted_offset,
       region,
       payload
FROM rid_part
ORDER BY region;
    part     |       id        | extracted_part_id | extracted_offset | region | payload 
-------------+-----------------+-------------------+------------------+--------+---------
 rid_part_p1 | 281474976710657 |                 1 |                1 |      1 | p1_row1
 rid_part_p2 | 562949953421313 |                 2 |                1 |      2 | p2_row1
(2 rows)

-- Cross-partition row movement (UPDATE changing partition key) preserves original id!
SELECT id AS p1_id FROM rid_part WHERE region = 1 \gset
UPDATE rid_part SET region = 2, payload = 'moved_from_p1_to_p2' WHERE id = :p1_id;
SELECT tableoid::regclass AS part,
       id,
       (id = :p1_id) AS id_preserved,
       region,
       payload
FROM rid_part
ORDER BY id;
    part     |       id        | id_preserved | region |       payload       
-------------+-----------------+--------------+--------+---------------------
 rid_part_p2 | 281474976710657 | t            |      2 | moved_from_p1_to_p2
 rid_part_p2 | 562949953421313 | f            |      2 | p2_row1
(2 rows)

-- Lookup moved row in partition 2 by its original id (which has partition_id = 1!)
SELECT id, region, payload FROM rid_part WHERE id = :p1_id;
       id        | region |       payload       
-----------------+--------+---------------------
 281474976710657 |      2 | moved_from_p1_to_p2
(1 row)

-- 10. COPY FROM with and without ROW IDENTITY column
CREATE TABLE rid_copy (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    val text
);
COPY rid_copy (val) FROM stdin;
-- COPY with explicit ROW IDENTITY values places tuples at their home TIDs
COPY rid_copy (id, val) FROM stdin;
SELECT id, ctid, val FROM rid_copy ORDER BY id;
 id | ctid  |       val       
----+-------+-----------------
  1 | (0,1) | copy_auto_1
  2 | (0,2) | copy_auto_2
  5 | (0,5) | copy_directed_5
  8 | (0,8) | copy_directed_8
(4 rows)

-- 11. ALTER TABLE ADD / DROP IDENTITY
CREATE TABLE rid_alter (a int NOT NULL, b text);
INSERT INTO rid_alter VALUES (10, 'ten'), (20, 'twenty');
ALTER TABLE rid_alter ADD COLUMN id bigint GENERATED ALWAYS AS ROW IDENTITY;
SELECT id, ctid, a, b FROM rid_alter ORDER BY id;
 id | ctid  | a  |   b    
----+-------+----+--------
  1 | (0,1) | 10 | ten
  2 | (0,2) | 20 | twenty
(2 rows)

-- Dropping identity materializes elided home values inline so all ids are preserved!
ALTER TABLE rid_alter ALTER COLUMN id DROP IDENTITY;
SELECT id, a, b FROM rid_alter ORDER BY id;
 id | a  |   b    
----+----+--------
  1 | 10 | ten
  2 | 20 | twenty
(2 rows)

-- 12. REINDEX TABLE and REINDEX TABLE CONCURRENTLY on off-home tuples
REINDEX TABLE rid_basic;
SELECT id, length(val), num FROM rid_basic WHERE id IN (1, 2, 3) ORDER BY id;
 id | length | num 
----+--------+-----
  1 |   3000 |  12
  2 |   3000 |  20
  3 |     16 | 300
(3 rows)

REINDEX TABLE CONCURRENTLY rid_basic;
SELECT id, length(val), num FROM rid_basic WHERE id IN (1, 2, 3) ORDER BY id;
 id | length | num 
----+--------+-----
  1 |   3000 |  12
  2 |   3000 |  20
  3 |     16 | 300
(3 rows)

-- Backing partial index still cannot be dropped directly after REINDEX CONCURRENTLY
DROP INDEX rid_basic_id_rowid_idx;
ERROR:  cannot drop index rid_basic_id_rowid_idx because column id of table rid_basic requires it
HINT:  You can drop column id of table rid_basic instead.
-- 13. VACUUM FULL and CLUSTER preservation of ROW IDENTITY & elision at home
CREATE TABLE rid_rewrite (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    v int NOT NULL,
    pad text
);
INSERT INTO rid_rewrite (v, pad) SELECT g, repeat('p', 200) FROM generate_series(1, 30) g;
DELETE FROM rid_rewrite WHERE v <= 15;
VACUUM FULL rid_rewrite;
SET enable_seqscan = off;
SELECT count(*) AS found_after_vacfull
FROM rid_rewrite r1
WHERE (SELECT r2.v FROM rid_rewrite r2 WHERE r2.id = r1.id) = r1.v;
 found_after_vacfull 
---------------------
                  15
(1 row)

RESET enable_seqscan;
-- Subsequent INSERTs after VACUUM FULL must not generate duplicate ROW IDENTITY keys
INSERT INTO rid_rewrite (v, pad) SELECT g, repeat('q', 200) FROM generate_series(31, 50) g;
SELECT count(*) AS total_rows, count(DISTINCT id) AS distinct_ids FROM rid_rewrite;
 total_rows | distinct_ids 
------------+--------------
         35 |           35
(1 row)

CREATE INDEX rid_rewrite_v_idx ON rid_rewrite (v DESC);
CLUSTER rid_rewrite USING rid_rewrite_v_idx;
SET enable_seqscan = off;
SELECT count(*) AS found_after_cluster
FROM rid_rewrite r1
WHERE (SELECT r2.v FROM rid_rewrite r2 WHERE r2.id = r1.id) = r1.v;
 found_after_cluster 
---------------------
                  35
(1 row)

RESET enable_seqscan;
DROP TABLE rid_rewrite;
-- 14. Arbitrary positive int64 keys via OVERRIDING SYSTEM VALUE (offset > MaxHeapTuplesPerPage or offset = 0)
CREATE TABLE rid_override (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    label text
);
INSERT INTO rid_override OVERRIDING SYSTEM VALUE VALUES (100000000, 'large_offset_bits');
INSERT INTO rid_override OVERRIDING SYSTEM VALUE VALUES (65536, 'zero_offset_bits');
SET enable_seqscan = off;
SELECT id, label FROM rid_override WHERE id = 100000000;
    id     |       label       
-----------+-------------------
 100000000 | large_offset_bits
(1 row)

SELECT id, label FROM rid_override WHERE id = 65536;
  id   |      label       
-------+------------------
 65536 | zero_offset_bits
(1 row)

SELECT id, label FROM rid_override WHERE id IN (100000000, 65536) ORDER BY id;
    id     |       label       
-----------+-------------------
     65536 | zero_offset_bits
 100000000 | large_offset_bits
(2 rows)

RESET enable_seqscan;
DROP TABLE rid_override;
-- 15. FOREIGN KEY referencing a GENERATED ALWAYS AS ROW IDENTITY column
CREATE TABLE rid_fk_parent (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    name text NOT NULL
);
CREATE TABLE rid_fk_child (
    cid int PRIMARY KEY,
    pid bigint REFERENCES rid_fk_parent(id) ON UPDATE RESTRICT ON DELETE CASCADE
);
INSERT INTO rid_fk_parent (name) VALUES ('parent_a'), ('parent_b');
INSERT INTO rid_fk_child SELECT 1, id FROM rid_fk_parent WHERE name = 'parent_a';
INSERT INTO rid_fk_child SELECT 2, id FROM rid_fk_parent WHERE name = 'parent_b';
INSERT INTO rid_fk_child VALUES (3, 99999999);  -- error: FK violation
ERROR:  insert or update on table "rid_fk_child" violates foreign key constraint "rid_fk_child_pid_fkey"
DETAIL:  Key (pid)=(99999999) is not present in table "rid_fk_parent".
DELETE FROM rid_fk_parent WHERE name = 'parent_a';
SELECT c.cid, p.name FROM rid_fk_child c JOIN rid_fk_parent p ON c.pid = p.id;
 cid |   name   
-----+----------
   2 | parent_b
(1 row)

DROP TABLE rid_fk_child, rid_fk_parent;
-- 16. Block-overflow extended key generation (ROWID_EXTENDED_FLAG)
CREATE TABLE rid_extkey (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    pad text
) WITH (partition_id_bits = 45, partition_id = 1, fillfactor = 10);
INSERT INTO rid_extkey (pad) SELECT repeat('z', 800) FROM generate_series(1, 6);
SELECT count(*) AS total_rows,
       count(DISTINCT id) AS distinct_ids,
       count(*) FILTER (WHERE (id & (1::bigint << 62)) <> 0) AS extended_keys
FROM rid_extkey;
 total_rows | distinct_ids | extended_keys 
------------+--------------+---------------
          6 |            6 |             4
(1 row)

SET enable_seqscan = off;
SELECT count(*) AS found_via_tidscan
FROM rid_extkey t1
WHERE EXISTS (SELECT 1 FROM rid_extkey t2 WHERE t2.id = t1.id);
 found_via_tidscan 
-------------------
                 6
(1 row)

RESET enable_seqscan;
DROP TABLE rid_extkey;
-- 17. Unprojected scans, aggregates, SPI records, and INSERT INTO ... SELECT *
CREATE TABLE rid_agg (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    k int PRIMARY KEY,
    payload text
);
INSERT INTO rid_agg (k, payload) SELECT g, repeat('x', 50) FROM generate_series(1, 5) g;
SELECT min(id), max(id), count(id), array_agg(id ORDER BY k) FROM rid_agg;
 min | max | count |  array_agg  
-----+-----+-------+-------------
   1 |   5 |     5 | {1,2,3,4,5}
(1 row)

DO $$
DECLARE
    r record;
BEGIN
    SELECT * INTO r FROM rid_agg ORDER BY k LIMIT 1;
    IF r.id IS DISTINCT FROM 1 THEN
        RAISE EXCEPTION 'expected r.id = 1, got %', r.id;
    END IF;
END $$;
CREATE TABLE rid_ins_src (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    k int
) WITH (partition_id = 3, partition_id_bits = 14);
CREATE TABLE rid_ins_dst_rowid (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    k int
);
CREATE TABLE rid_ins_dst_plain (
    id bigint NOT NULL,
    k int
);
INSERT INTO rid_ins_src (k) VALUES (10), (20);
INSERT INTO rid_ins_dst_rowid OVERRIDING SYSTEM VALUE SELECT * FROM rid_ins_src;
INSERT INTO rid_ins_dst_plain SELECT * FROM rid_ins_src;
SELECT id, k FROM rid_ins_dst_rowid ORDER BY k;
       id        | k  
-----------------+----
 844424930131969 | 10
 844424930131970 | 20
(2 rows)

SELECT id, k FROM rid_ins_dst_plain ORDER BY k;
       id        | k  
-----------------+----
 844424930131969 | 10
 844424930131970 | 20
(2 rows)

DROP TABLE rid_agg, rid_ins_src, rid_ins_dst_rowid, rid_ins_dst_plain;
-- 18. ALTER TABLE ... DROP IDENTITY on a partitioned table
CREATE TABLE rid_drop_part (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    k int
) PARTITION BY LIST (k);
CREATE TABLE rid_drop_part_1 PARTITION OF rid_drop_part FOR VALUES IN (1);
INSERT INTO rid_drop_part (k) VALUES (1);
ALTER TABLE rid_drop_part ALTER COLUMN id DROP IDENTITY;
INSERT INTO rid_drop_part (id, k) VALUES (999, 1);
SELECT id, k FROM rid_drop_part ORDER BY id;
       id        | k 
-----------------+---
             999 | 1
 281474976710657 | 1
(2 rows)

DROP TABLE rid_drop_part;
-- 19. ALTER TABLE ... ATTACH PARTITION with a sub-partitioned table
CREATE TABLE rid_root_p (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    a int,
    b int
) PARTITION BY LIST (a);
CREATE TABLE rid_root_p1 PARTITION OF rid_root_p FOR VALUES IN (1);
CREATE TABLE rid_sub_p (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    a int,
    b int
) PARTITION BY LIST (b);
CREATE TABLE rid_sub_p1 PARTITION OF rid_sub_p FOR VALUES IN (10);
ALTER TABLE rid_root_p ATTACH PARTITION rid_sub_p FOR VALUES IN (2);
INSERT INTO rid_root_p (a, b) VALUES (1, 10), (2, 10);
SELECT tableoid::regclass AS part, id, id >> 48 AS part_id, a, b
FROM rid_root_p ORDER BY a;
    part     |       id        | part_id | a | b  
-------------+-----------------+---------+---+----
 rid_root_p1 | 281474976710657 |       1 | 1 | 10
 rid_sub_p1  | 562949953421313 |       2 | 2 | 10
(2 rows)

DROP TABLE rid_root_p;
-- 20. ALTER TABLE ... ATTACH PARTITION on a table with off-home rows + VACUUM
CREATE TABLE rid_attach_parent (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    p int,
    val text
) PARTITION BY LIST (p);
CREATE TABLE rid_attach_p1 PARTITION OF rid_attach_parent FOR VALUES IN (1);
CREATE TABLE rid_attach_standalone (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    p int,
    val text
);
CREATE INDEX ON rid_attach_standalone (val);
INSERT INTO rid_attach_standalone (p, val)
VALUES (2, repeat('a', 200)), (2, repeat('b', 200)), (2, repeat('c', 200));
UPDATE rid_attach_standalone SET val = repeat('z', 200) WHERE id = 3;
ALTER TABLE rid_attach_parent ATTACH PARTITION rid_attach_standalone FOR VALUES IN (2);
CALL rid_wait_for_xmin_horizon();
VACUUM rid_attach_standalone;
CALL rid_wait_for_xmin_horizon();
VACUUM rid_attach_standalone;
INSERT INTO rid_attach_standalone (p, val) VALUES (2, 'new_row');
SELECT ctid, id, id >> 48 AS part_id, (id >> 16) & 65535 AS home_blk, id & 65535 AS home_off, length(val)
FROM rid_attach_parent ORDER BY id;
 ctid  |       id        | part_id | home_blk | home_off | length 
-------+-----------------+---------+----------+----------+--------
 (0,1) | 562949953421313 |       2 |        0 |        1 |    200
 (0,2) | 562949953421314 |       2 |        0 |        2 |    200
 (0,4) | 562949953421315 |       2 |        0 |        3 |    200
 (0,5) | 562949953421317 |       2 |        0 |        5 |      7
(4 rows)

SET enable_seqscan = off;
SELECT ctid, id, length(val) FROM rid_attach_parent WHERE id = (2::bigint << 48) | 3;
 ctid  |       id        | length 
-------+-----------------+--------
 (0,4) | 562949953421315 |    200
(1 row)

RESET enable_seqscan;
DROP TABLE rid_attach_parent;
DROP PROCEDURE rid_wait_for_xmin_horizon();
-- Cleanup
DROP TABLE rid_basic, rid_explicit_pk, rid_sugar, rid_part, rid_copy, rid_alter;
