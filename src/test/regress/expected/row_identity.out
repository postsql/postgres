 val    | text   |           |          | 
Indexes:
    "rid_sugar_id_rowid_idx" UNIQUE, btree (id) WHERE id IS NULL

-- 3. Physical tuple storage & zero-byte in-place elision
CREATE TABLE rid_size_rowid (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    a int4 NOT NULL
);
CREATE TABLE rid_size_plain (
    id bigint NOT NULL,
    a int4 NOT NULL
);
INSERT INTO rid_size_rowid (a) SELECT g FROM generate_series(1, 1000) g;
INSERT INTO rid_size_plain (id, a) SELECT g, g FROM generate_series(1, 1000) g;
-- On-disk heap relation size is smaller for rid_size_rowid because the 8-byte
-- id column is elided (0 bytes on disk) when tuples reside at their home TIDs!
SELECT pg_relation_size('rid_size_rowid') < pg_relation_size('rid_size_plain') AS rowid_heap_smaller,
       (pg_relation_size('rid_size_plain') - pg_relation_size('rid_size_rowid')) / current_setting('block_size')::int AS pages_saved;
 rowid_heap_smaller | pages_saved 
--------------------+-------------
 t                  |           1
(1 row)

DROP TABLE rid_size_rowid, rid_size_plain;
-- Also verify tuple with NULLable columns (hasnull bitmap) + elided ROW IDENTITY
INSERT INTO rid_basic (val, num) VALUES
    ('alpha', 10),
    (NULL, 20),
    ('gamma', NULL)
RETURNING id, ctid, val, num;
 id | ctid  |  val  | num 
----+-------+-------+-----
  1 | (0,1) | alpha |  10
  2 | (0,2) |       |  20
  3 | (0,3) | gamma |    
(3 rows)

-- Verify exact formula: id = (block << 16) | offset
SELECT id, ctid,
       ((split_part( trim(both '()' from ctid::text), ',', 1 )::bigint << 16) |
         split_part( trim(both '()' from ctid::text), ',', 2 )::bigint) AS expected_id
FROM rid_basic
ORDER BY id;
 id | ctid  | expected_id 
----+-------+-------------
  1 | (0,1) |           1
  2 | (0,2) |           2
  3 | (0,3) |           3
(3 rows)

-- Verify partial B-tree index has 0 leaf entries when all tuples are at home
-- (1 page = 8192 bytes, metapage only)
SELECT pg_relation_size('rid_basic_id_rowid_idx') / current_setting('block_size')::int AS index_blocks_at_home;
 index_blocks_at_home 
----------------------
                    1
(1 row)

-- 4. INSERT restrictions and OVERRIDING clauses
INSERT INTO rid_basic VALUES (99, 'illegal', 0);  -- error: cannot insert non-DEFAULT without OVERRIDING
ERROR:  cannot insert a non-DEFAULT value into column "id"
DETAIL:  Column "id" is an identity column defined as GENERATED ALWAYS.
HINT:  Use OVERRIDING SYSTEM VALUE to override.
INSERT INTO rid_basic VALUES (DEFAULT, 'delta', 40) RETURNING id, ctid, val, num;
 id | ctid  |  val  | num 
----+-------+-------+-----
  4 | (0,4) | delta |  40
(1 row)

INSERT INTO rid_basic OVERRIDING USER VALUE VALUES (999, 'epsilon', 50) RETURNING id, ctid, val, num;
 id | ctid  |   val   | num 
----+-------+---------+-----
  5 | (0,5) | epsilon |  50
(1 row)

-- Directed INSERT with OVERRIDING SYSTEM VALUE into a valid unallocated home slot
-- Block 0 offset 10 -> key = 10
INSERT INTO rid_basic OVERRIDING SYSTEM VALUE VALUES (10, 'directed_at_10', 100)
RETURNING id, ctid, val, num;
 id |  ctid  |      val       | num 
----+--------+----------------+-----
 10 | (0,10) | directed_at_10 | 100
(1 row)

-- Subsequent normal INSERT allocates the gap offset 6!
INSERT INTO rid_basic (val, num) VALUES ('fills_gap_6', 60)
RETURNING id, ctid, val, num;
 id | ctid  |     val     | num 
----+-------+-------------+-----
  6 | (0,6) | fills_gap_6 |  60
(1 row)

-- Duplicate key via OVERRIDING SYSTEM VALUE against an existing home tuple must fail!
INSERT INTO rid_basic OVERRIDING SYSTEM VALUE VALUES (1, 'dup_home', 999);  -- error: unique violation
ERROR:  duplicate key value violates unique constraint "rid_basic"
DETAIL:  Key (id)=(1) already exists.
INSERT INTO rid_basic OVERRIDING SYSTEM VALUE VALUES (10, 'dup_10', 999);  -- error: unique violation
ERROR:  duplicate key value violates unique constraint "rid_basic"
DETAIL:  Key (id)=(10) already exists.
-- 5. Same-page HOT UPDATE vs Cross-page Non-HOT UPDATE
-- Same-page HOT update preserves id = 1 and keeps it elided (0 index entries)
UPDATE rid_basic SET val = 'alpha_hot', num = 11 WHERE id = 1
RETURNING id, ctid, val, num;
 id | ctid  |    val    | num 
----+-------+-----------+-----
  1 | (0,7) | alpha_hot |  11
(1 row)

SELECT pg_relation_size('rid_basic_id_rowid_idx') / current_setting('block_size')::int AS index_blocks_after_hot;
 index_blocks_after_hot 
------------------------
                      1
(1 row)

-- Update with DEFAULT on id column is allowed and preserves id
UPDATE rid_basic SET id = DEFAULT, num = 12 WHERE id = 1
RETURNING id, ctid, val, num;
 id | ctid  |    val    | num 
----+-------+-----------+-----
  1 | (0,8) | alpha_hot |  12
(1 row)

-- Updating id to an explicit value is rejected
UPDATE rid_basic SET id = 500 WHERE id = 1;  -- error: cannot update row identity column
ERROR:  column "id" can only be updated to DEFAULT
DETAIL:  Column "id" is an identity column defined as GENERATED ALWAYS.
-- Force cross-page non-HOT update by disabling compression on val and expanding it
-- so tuples move off block 0 onto block 1
ALTER TABLE rid_basic ALTER COLUMN val SET STORAGE PLAIN;
UPDATE rid_basic SET val = repeat('X', 3000) WHERE id = 1
RETURNING id, ctid, length(val), num;
 id | ctid  | length | num 
----+-------+--------+-----
  1 | (0,9) |   3000 |  12
(1 row)

UPDATE rid_basic SET val = repeat('Y', 3000) WHERE id = 2
RETURNING id, ctid, length(val), num;
 id |  ctid  | length | num 
----+--------+--------+-----
  2 | (0,11) |   3000 |  20
(1 row)

UPDATE rid_basic SET val = repeat('Z', 3000) WHERE id = 3
RETURNING id, ctid, length(val), num;
 id | ctid  | length | num 
----+-------+--------+-----
  3 | (1,1) |   3000 |    
(1 row)

-- Now tuples have moved off block 0 to block > 0, so their id is
-- stored inline and indexed in rid_basic_id_rowid_idx!
SELECT id, (ctid::text <> ('(0,' || id::text || ')')) AS moved_off_home, length(val), num
FROM rid_basic
WHERE id IN (1, 2, 3)
ORDER BY id;
 id | moved_off_home | length | num 
----+----------------+--------+-----
  1 | t              |   3000 |  12
  2 | t              |   3000 |  20
  3 | t              |   3000 |    
(3 rows)

