--
-- GENERATED ALWAYS AS ROW IDENTITY regression tests
--
-- 1. DDL validation & error cases
CREATE TABLE rid_err (id int GENERATED ALWAYS AS ROW IDENTITY);  -- error: must be bigint
ERROR:  row identity column "id" must be of type bigint
LINE 1: CREATE TABLE rid_err (id int GENERATED ALWAYS AS ROW IDENTIT...
                                 ^
CREATE TABLE rid_err (id smallint GENERATED ALWAYS AS ROW IDENTITY);  -- error: must be bigint
ERROR:  row identity column "id" must be of type bigint
LINE 1: CREATE TABLE rid_err (id smallint GENERATED ALWAYS AS ROW ID...
                                 ^
CREATE TABLE rid_err (id text GENERATED ALWAYS AS ROW IDENTITY);  -- error: must be bigint
ERROR:  row identity column "id" must be of type bigint
LINE 1: CREATE TABLE rid_err (id text GENERATED ALWAYS AS ROW IDENTI...
                                 ^
CREATE TABLE rid_err (id bigint GENERATED BY DEFAULT AS ROW IDENTITY);  -- error: syntax
ERROR:  for a row identity column, GENERATED ALWAYS must be specified
LINE 1: CREATE TABLE rid_err (id bigint GENERATED BY DEFAULT AS ROW ...
                                                  ^
CREATE TABLE rid_err (id bigint GENERATED ALWAYS AS ROW IDENTITY (START WITH 1));  -- error: no sequence options
ERROR:  syntax error at or near "("
LINE 1: ...d_err (id bigint GENERATED ALWAYS AS ROW IDENTITY (START WIT...
                                                             ^
CREATE TABLE rid_err (id bigint DEFAULT 42 GENERATED ALWAYS AS ROW IDENTITY);  -- error: conflicting default
ERROR:  both default and identity specified for column "id" of table "rid_err"
LINE 1: CREATE TABLE rid_err (id bigint DEFAULT 42 GENERATED ALWAYS ...
                                                   ^
CREATE TABLE rid_err (
    id1 bigint GENERATED ALWAYS AS ROW IDENTITY,
    id2 bigint GENERATED ALWAYS AS ROW IDENTITY
);  -- error: at most one ROW IDENTITY column per table
ERROR:  multiple row identity columns for table "rid_err" are not allowed
LINE 3:     id2 bigint GENERATED ALWAYS AS ROW IDENTITY
                       ^
CREATE TABLE rid_err (id bigint GENERATED ALWAYS AS ROW IDENTITY)
    WITH (partition_bits = 12, partition_id = 5000);  -- error: partition_id exceeds 2^12 - 1
ERROR:  partition_id 5000 is out of range for partition_id_bits 12
-- 2. Valid table creation: implicit PK, explicit PK, and rowidentity syntactic sugar
CREATE TABLE rid_basic (
    id bigint GENERATED ALWAYS AS ROW IDENTITY,
    val text,
    num int
);
CREATE TABLE rid_explicit_pk (
    id bigint GENERATED ALWAYS AS ROW IDENTITY PRIMARY KEY,
    val text
);
CREATE TABLE rid_sugar (
    id rowidentity,
    val text
);
-- Verify pg_attribute catalog metadata (attidentity = 'r', attnotnull = true, no sequence)
SELECT attrelid::regclass, attname, atttypid::regtype, attnotnull, attidentity, atthasdef
FROM pg_attribute
WHERE attrelid IN ('rid_basic'::regclass, 'rid_explicit_pk'::regclass, 'rid_sugar'::regclass)
  AND attnum > 0
ORDER BY attrelid::regclass::text, attnum;
    attrelid     | attname | atttypid | attnotnull | attidentity | atthasdef 
-----------------+---------+----------+------------+-------------+-----------
 rid_basic       | id      | bigint   | t          | r           | f
 rid_basic       | val     | text     | f          |             | f
 rid_basic       | num     | integer  | f          |             | f
 rid_explicit_pk | id      | bigint   | t          | r           | f
 rid_explicit_pk | val     | text     | f          |             | f
 rid_sugar       | id      | bigint   | t          | r           | f
 rid_sugar       | val     | text     | f          |             | f
(7 rows)

-- Verify information_schema.columns view
SELECT table_name, column_name, data_type, is_nullable, is_identity, identity_generation,
       identity_start, identity_increment
FROM information_schema.columns
WHERE table_name IN ('rid_basic', 'rid_explicit_pk', 'rid_sugar')
  AND column_name = 'id'
ORDER BY table_name;
   table_name    | column_name | data_type | is_nullable | is_identity | identity_generation | identity_start | identity_increment 
-----------------+-------------+-----------+-------------+-------------+---------------------+----------------+--------------------
 rid_basic       | id          | bigint    | NO          | YES         | ALWAYS              |                | 
 rid_explicit_pk | id          | bigint    | NO          | YES         | ALWAYS              |                | 
 rid_sugar       | id          | bigint    | NO          | YES         | ALWAYS              |                | 
(3 rows)

