{
  "suite": "pgbench-brokerage",
  "description": "TPC-E-inspired financial brokerage OLTP workload across 16 tables and 10 stored procedures",
  "scale": 2,
  "no_vacuum": true,
  "clients": 8,
  "threads": 4,
  "duration_sec": 60,
  "init_steps": [
    {
      "name": "schema",
      "file": "pgbench_brokerage_schema.sql"
    },
    {
      "name": "data",
      "file": "pgbench_brokerage_init.sql",
      "clients": 2,
      "threads": 2,
      "variables": {
        "num_workers": 2
      }
    },
    {
      "name": "constraints",
      "file": "pgbench_brokerage_constraints.sql"
    }
  ],
  "scripts": [
    {
      "file": "pgbench_brokerage_trade_order.sql",
      "weight": 10
    },
    {
      "file": "pgbench_brokerage_trade_result.sql",
      "weight": 10
    },
    {
      "file": "pgbench_brokerage_customer_position.sql",
      "weight": 13
    },
    {
      "file": "pgbench_brokerage_market_watch.sql",
      "weight": 18
    },
    {
      "file": "pgbench_brokerage_broker_volume.sql",
      "weight": 5
    },
    {
      "file": "pgbench_brokerage_trade_status.sql",
      "weight": 44
    }
  ],
  "sla": [
    "total:p95<=5000ms"
  ]
}
